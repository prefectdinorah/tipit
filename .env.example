# 🔐 Environment Variables Template
# Скопируйте этот файл в .env и заполните реальными значениями

# ========================================
# DATABASE
# ========================================

# PostgreSQL (основная БД для пользователей, настроек, сессий)
DATABASE_URL="postgresql://username:password@45.144.52.58:5432/tipit_prod"

# MongoDB (для донатов и логов)
MONGODB_URI="mongodb://username:password@45.144.52.58:27017/tipit_prod"

# ==============================================
# 🌍 APPLICATION SETTINGS
# ==============================================

# Окружение: development (для DEV) | production (для IFT)
NODE_ENV="production"

# URL приложения
# DEV: http://45.144.52.219:3001
# IFT: http://45.144.52.219:3000
NEXT_PUBLIC_APP_URL="http://45.144.52.219:3000"

# Порт приложения
# DEV: 3001
# IFT: 3000
PORT=3000

# ========================================
# SECURITY
# ========================================

# Секретный ключ для сессий (сгенерируйте случайную строку)
# Генерация: openssl rand -base64 32
SESSION_SECRET="your-super-secret-session-key-change-this"

# ========================================
# OPTIONAL
# ========================================

# Для логирования (опционально)
LOG_LEVEL="info"

# Для email уведомлений (если настроено)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"

# Для payment gateway (если настроено)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ========================================
# NOTES
# ========================================
# 
# Production (.env):
#   DATABASE_URL → tipit_prod
#   MONGODB_URI → tipit_prod
#   PORT=3000
#
# Staging (.env):
#   DATABASE_URL → tipit_staging
#   MONGODB_URI → tipit_staging
#   PORT=3001
#   NEXT_PUBLIC_APP_URL="http://45.144.52.219:8080"
