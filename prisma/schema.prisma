generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String    @map("password_hash")
  displayName   String?   @map("display_name")
  avatarUrl     String?   @map("avatar_url")
  bio           String?
  timezone      String    @default("UTC")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")
  isActive      Boolean   @default(true) @map("is_active")
  isVerified    Boolean   @default(false) @map("is_verified")
  isPremium     Boolean   @default(false) @map("is_premium")
  
  // Twitch integration
  twitchId      String?   @unique @map("twitch_id")
  twitchUsername String?  @map("twitch_username")
  twitchAccessToken String? @map("twitch_access_token")
  twitchRefreshToken String? @map("twitch_refresh_token")
  twitchTokenExpiresAt DateTime? @map("twitch_token_expires_at")
  isLive        Boolean   @default(false) @map("is_live")

  settings      StreamerSettings?
  sessions      Session[]
  paymentMethods PaymentMethod[]
  donationGoals DonationGoal[]
  bannedContent BannedContent[]
  socialLinks   SocialLink[]
  statistics    UserStatistic[]

  @@map("users")
}

model StreamerSettings {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @unique @map("user_id")
  donationGoal            Int      @default(1000) @map("donation_goal")
  donationGoalDescription String?  @map("donation_goal_description")
  minDonationAmount       Decimal  @default(1.00) @map("min_donation_amount") @db.Decimal(10, 2)
  trackRequestMinimum     Decimal  @default(20.00) @map("track_request_minimum") @db.Decimal(10, 2)
  alertVolume             Int      @default(75) @map("alert_volume")
  alertDuration           Int      @default(5) @map("alert_duration")
  soundAlertEnabled       Boolean  @default(true) @map("sound_alert_enabled")
  visualAlertEnabled      Boolean  @default(true) @map("visual_alert_enabled")
  ttsEnabled              Boolean  @default(false) @map("tts_enabled")
  theme                   String   @default("purple")
  primaryColor            String   @default("#7c3aed") @map("primary_color")
  accentColor             String   @default("#ec4899") @map("accent_color")
  currency                String   @default("USD")
  language                String   @default("en")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streamer_settings")
}

model Session {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  token              String    @unique
  refreshToken       String?   @unique @map("refresh_token")
  expiresAt          DateTime  @map("expires_at")
  refreshExpiresAt   DateTime? @map("refresh_expires_at")
  ipAddress          String?   @map("ip_address")
  userAgent          String?   @map("user_agent")
  deviceInfo         Json?     @map("device_info")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  lastActivityAt     DateTime  @default(now()) @map("last_activity_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model PaymentMethod {
  id                   Int      @id @default(autoincrement())
  userId               Int      @map("user_id")
  provider             String
  accountId            String?  @map("account_id")
  apiKeyEncrypted      String?  @map("api_key_encrypted")
  webhookSecretEncrypted String? @map("webhook_secret_encrypted")
  isActive             Boolean  @default(true) @map("is_active")
  isVerified           Boolean  @default(false) @map("is_verified")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payment_methods")
}

model DonationGoal {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  title         String
  description   String?
  targetAmount  Decimal   @map("target_amount") @db.Decimal(10, 2)
  currentAmount Decimal   @default(0) @map("current_amount") @db.Decimal(10, 2)
  currency      String    @default("USD")
  isActive      Boolean   @default(true) @map("is_active")
  isCompleted   Boolean   @default(false) @map("is_completed")
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("donation_goals")
}

model BannedContent {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  contentType String   @map("content_type")
  value       String
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, value])
  @@index([userId])
  @@map("banned_content")
}

model SocialLink {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  platform     String
  url          String
  isVerified   Boolean  @default(false) @map("is_verified")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
  @@map("social_links")
}

model UserStatistic {
  id                 Int      @id @default(autoincrement())
  userId             Int      @map("user_id")
  totalDonations     Decimal  @default(0) @map("total_donations") @db.Decimal(10, 2)
  totalDonors        Int      @default(0) @map("total_donors")
  totalTrackRequests Int      @default(0) @map("total_track_requests")
  averageDonation    Decimal  @default(0) @map("average_donation") @db.Decimal(10, 2)
  highestDonation    Decimal  @default(0) @map("highest_donation") @db.Decimal(10, 2)
  date               DateTime @default(now()) @db.Date
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("user_statistics")
}

model AlertSettings {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique @map("user_id")
  
  // General settings
  minAmount        Decimal  @default(1.00) @map("min_amount") @db.Decimal(10, 2)
  messageTemplate  String   @default("{name} задонатил {amount}!") @map("message_template")
  showDonorName    Boolean  @default(true) @map("show_donor_name")
  
  // Visual settings
  animationType    String   @default("slide") @map("animation_type") // fade, slide, bounce, zoom
  duration         Int      @default(5) // seconds
  backgroundColor  String   @default("#6366f1") @map("background_color")
  textColor        String   @default("#ffffff") @map("text_color")
  transparentBackground Boolean @default(false) @map("transparent_background")
  
  // Header (template) settings
  headerFontSize   Int      @default(24) @map("header_font_size")
  headerFontFamily String   @default("sans-serif") @map("header_font_family")
  headerPositionX  Int      @default(50) @map("header_position_x") // percentage
  headerPositionY  Int      @default(30) @map("header_position_y")
  headerWidth      Int      @default(400) @map("header_width") // pixels
  headerHeight     Int      @default(60) @map("header_height")
  
  // Message settings
  messageFontSize  Int      @default(18) @map("message_font_size")
  messageFontFamily String  @default("sans-serif") @map("message_font_family")
  messagePositionX Int      @default(50) @map("message_position_x")
  messagePositionY Int      @default(70) @map("message_position_y")
  messageWidth     Int      @default(400) @map("message_width")
  messageHeight    Int      @default(80) @map("message_height")
  
  // Image settings
  enableImage      Boolean  @default(true) @map("enable_image")
  imageUrl         String?  @map("image_url")
  imageWidth       Int      @default(80) @map("image_width")
  imageHeight      Int      @default(80) @map("image_height")
  imagePositionX   Int      @default(20) @map("image_position_x")
  imagePositionY   Int      @default(50) @map("image_position_y")
  imageAsBackground Boolean @default(false) @map("image_as_background")
  
  // Sound settings
  enableSound      Boolean  @default(true) @map("enable_sound")
  soundUrl         String?  @map("sound_url")
  soundVolume      Int      @default(70) @map("sound_volume")
  
  // TTS settings
  enableTTS        Boolean  @default(false) @map("enable_tts")
  ttsVoice         String   @default("female") @map("tts_voice") // male, female, robot
  ttsSpeed         Float    @default(1.0) @map("tts_speed") @db.Real
  ttsVolume        Int      @default(80) @map("tts_volume")
  readDonorName    Boolean  @default(true) @map("read_donor_name")
  readAmount       Boolean  @default(true) @map("read_amount")
  readMessage      Boolean  @default(true) @map("read_message")
  
  // Security
  alertToken       String   @unique @default(uuid()) @map("alert_token")
  
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("alert_settings")
}
